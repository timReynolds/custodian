{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custodian.dev/schemas/stageb/assessment_result.schema.json",
  "title": "StageBAssessmentResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_type",
    "risk",
    "disposition",
    "confidence",
    "summary",
    "findings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "assessment_type": {
      "type": "string",
      "enum": [
        "SECURITY_REVIEW",
        "IP_PROVENANCE"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "NONE"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "CLEAR",
        "REVIEW",
        "ESCALATE",
        "BLOCK",
        "INDETERMINATE"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "evidence_ids",
          "reason",
          "recommended_action"
        ],
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "recommended_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
